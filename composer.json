{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "mykholy/laravel-accessproof",
  "description": "Catch Laravel authorization regressions, IDOR/BOLA, cross-tenant leaks and unauthorized database writes in HTTP feature tests.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "authorization",
    "security-testing",
    "idor",
    "bola",
    "multi-tenancy",
    "phpunit",
    "regression-testing"
  ],
  "authors": [
    {
      "name": "Ahmed El-Kholy",
      "homepage": "https://github.com/mykholy"
    }
  ],
  "require": {
    "laravel/framework": "^12.0 || ^13.0",
    "php": "^8.3",
    "phpunit/phpunit": "^11.5.50 || ^12.5.8 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Mykholy\\AccessProof\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mykholy\\AccessProof\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist",
    "analyse": "phpstan analyse --memory-limit=1G",
    "format": "pint",
    "format-check": "pint --test"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "homepage": "https://github.com/mykholy/laravel-accessproof",
  "support": {
    "issues": "https://github.com/mykholy/laravel-accessproof/issues",
    "source": "https://github.com/mykholy/laravel-accessproof"
  }
}
